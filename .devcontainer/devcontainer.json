{
  "name": "novacrest-qna",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    7860,
    8501
  ],
  "portsAttributes": {
    "7860": {
      "label": "Backend (Flask)",
      "visibility": "public"
    },
    "8501": {
      "label": "Frontend (Streamlit)",
      "visibility": "public"
    }
  },
  "postCreateCommand": "docker compose up -d --build"
}